# Keep lightweight JSON/CSV/MD results and reports tracked in git
!results/**/*.json
!results/**/*.csv
!results/**/*.md
!experiments/**/test_results.json
!experiments/**/training_summary.json
!experiments/**/loss_history.csv
!experiments/**/config_used.yaml
!reports/**
